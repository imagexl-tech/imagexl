# Copy this file to .env and fill in real values before deploying.

# Secret used to sign admin login tokens. Generate a random string for production.
SECRET_KEY=change-this-to-a-long-random-string

# Initial admin account (only used the first time the database is created/seeded).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Comma-separated list of origins allowed to call this API (your frontend URL(s)).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
